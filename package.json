{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "demo": "bun scripts/demo.ts",
    "queues:init": "bun scripts/init-queues.ts",
    "demo:sqs": "bun scripts/demo-sqs.ts",
    "smoke:compose": "bun scripts/smoke-compose.ts",
    "verify": "bun run typecheck && bun test tests/unit && bun run test:integration",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/infrastructure/database/manage.ts up",
    "db:rollback": "bun src/infrastructure/database/manage.ts down",
    "db:check": "bun src/infrastructure/database/manage.ts check"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "@mikro-orm/core": "~6.6.0",
    "@mikro-orm/migrations": "~6.6.0",
    "@mikro-orm/postgresql": "~6.6.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "decimal.js": "^10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
